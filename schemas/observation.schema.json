{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/0xSneaks/MusePark/schemas/observation.schema.json",
  "title": "AMP signed oracle observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id",
    "feed",
    "observation_ts",
    "published_ts",
    "value",
    "sig"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "feed": {
      "type": "string"
    },
    "observation_ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "published_ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "value": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]{0,38})$",
          "description": "Signed integer as decimal string (i128). '-0' is invalid."
        },
        {
          "type": "boolean"
        }
      ]
    },
    "sig": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}([0-9a-f]{2})?$"
    }
  }
}
